{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\" || true"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(npm test)",
			"Bash(npm run lint)",
			"Bash(npm run build)",
			"Bash(npm run verify)",
			"Bash(npx astro check)",
			"Bash(node scripts/check-*)",
			"Bash(git status)",
			"Bash(git status *)",
			"Bash(git log)",
			"Bash(git log *)",
			"Bash(git diff)",
			"Bash(git diff *)"
		],
		"deny": [
			"Read(./scripts/archive-aliases.local.json)",
			"Read(**/archive-aliases.local.json)",
			"Bash(*archive-aliases.local.json*)"
		]
	}
}
