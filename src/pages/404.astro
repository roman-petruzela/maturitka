---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';
---

<BaseLayout title="Stránka nenalezena" description="Tato stránka neexistuje nebo byla přesunuta.">
	<h1>Stránka nenalezena (chyba 404)</h1>
	<p>Odkaz, na který jsi klikl, buď neexistuje, nebo byl přesunut jinam.</p>
	<ol class="record-list">
		{
			SUBJECT_KEYS.map((key, i) => (
				<li>
					<a class="record" href={`/${key}/`}>
						<span class="record-num">{String(i + 1).padStart(2, '0')}</span>
						<div class="record-body">
							<h2 class="record-title">{SUBJECTS[key].label}</h2>
							<span class="record-desc">{SUBJECTS[key].description}</span>
						</div>
					</a>
				</li>
			))
		}
	</ol>
</BaseLayout>
