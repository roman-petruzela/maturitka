---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicRow from '../../components/TopicRow.astro';
import { SUBJECTS, SUBJECT_KEYS, type SubjectKey } from '../../lib/subjects';
import { cleanId, groupLabel, groupOfId, sortEntriesByOrder, sortGroupKeys } from '../../lib/groups';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	return SUBJECT_KEYS.map((subject) => ({ params: { subject } }));
}

const subject = Astro.params.subject as SubjectKey;
const entries = await getCollection(subject);

const groups = new Map<string | null, typeof entries>();
for (const entry of entries) {
	const g = groupOfId(entry.id);
	if (!groups.has(g)) groups.set(g, []);
	groups.get(g)!.push(entry);
}

const sortEntries = sortEntriesByOrder<(typeof entries)[number]>;

const orderedGroupKeys = sortGroupKeys(subject, [...groups.keys()]);
const namedGroupKeys = orderedGroupKeys.filter((g): g is string => g !== null);

// Seven of the twelve subjects keep every topic in one flat, numbered run
// (no category folders at all). Those get a single list flowed into
// balanced columns; the rest get a grid of per-category blocks.
const isFlat = orderedGroupKeys.length === 1 && orderedGroupKeys[0] === null;

// A category longer than this is allowed to flow across column breaks.
// Keeping every block atomic looked tidier but wrecked the balancing: Český
// jazyk's 97-topic "Rozbor knih a četba" is taller than a third of the page
// on its own, so it claimed a whole column and left the third one empty.
const SPLIT_AT = 20;

// Czech needs three number forms: 1 téma / 2–4 témata / 5+ témat.
const plural = (n: number, one: string, few: string, many: string) =>
	n === 1 ? one : n >= 2 && n <= 4 ? few : many;
---

<BaseLayout
	title={SUBJECTS[subject].label}
	description={SUBJECTS[subject].description}
	activeSubject={subject}
	layout="index"
>
	<p class="crumb"><a href="/">← Zpět na předměty</a></p>
	<div class="subject-head">
		<h1>{SUBJECTS[subject].label}</h1>
		<p>{SUBJECTS[subject].description}</p>
		<p class="subject-head-tally">
			{entries.length}&nbsp;{plural(entries.length, 'téma', 'témata', 'témat')}
			{
				namedGroupKeys.length > 0 &&
					` ve ${namedGroupKeys.length} ${plural(namedGroupKeys.length, 'kategorii', 'kategoriích', 'kategoriích')}`
			}
		</p>
	</div>

	{
		namedGroupKeys.length >= 3 && (
			<nav class="group-jump" aria-label="Kategorie předmětu">
				{namedGroupKeys.map((g) => (
					<a href={`#${g}`}>{groupLabel(subject, g)}</a>
				))}
			</nav>
		)
	}

	{
		isFlat ? (
			<ul class="topic-list topic-list--flat">
				{sortEntries(groups.get(null)!).map((entry) => (
					<TopicRow
						href={`/${subject}/${cleanId(entry.id)}/`}
						title={entry.data.title}
						order={entry.data.order}
						hasExercises={entry.data.hasExercises}
						tags={entry.data.tags}
					/>
				))}
			</ul>
		) : (
			<div class="group-grid">
				{orderedGroupKeys.map((g) => (
					<section class={groups.get(g)!.length > SPLIT_AT ? 'group-block group-block--splittable' : 'group-block'}>
						<h2 class="group-block-head" id={g ?? undefined}>
							<span class="group-block-title">{g ? groupLabel(subject, g) : 'Ostatní témata'}</span>
							<span class="group-block-count">{groups.get(g)!.length}</span>
						</h2>
						<ul class="topic-list">
							{sortEntries(groups.get(g)!).map((entry) => (
								<TopicRow
									href={`/${subject}/${cleanId(entry.id)}/`}
									title={entry.data.title}
									order={entry.data.order}
									hasExercises={entry.data.hasExercises}
									tags={entry.data.tags}
								/>
							))}
						</ul>
					</section>
				))}
			</div>
		)
	}
</BaseLayout>
