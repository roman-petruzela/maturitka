---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathScratchpad from '../../components/MathScratchpad.astro';
import TopicFilmstrip from '../../components/TopicFilmstrip.astro';
import { SUBJECTS, SUBJECT_KEYS, type SubjectKey } from '../../lib/subjects';
import { cleanId, groupLabel, groupOfId, sortEntriesByOrder, sortGroupKeys } from '../../lib/groups';
import { getCollection, render } from 'astro:content';

type Entry = Awaited<ReturnType<typeof getCollection<SubjectKey>>>[number];
export type FilmstripItem = {
	id: string;
	title: string;
	order: number | null;
	group: string | null;
	groupLabel: string;
	hasExercises: boolean;
};

export async function getStaticPaths() {
	const paths: {
		params: { subject: SubjectKey; slug: string };
		props: {
			entry: Entry;
			subject: SubjectKey;
			prev: Entry | null;
			next: Entry | null;
			filmstrip: FilmstripItem[];
			filmstripIndex: number;
		};
	}[] = [];
	for (const subject of SUBJECT_KEYS) {
		const entries = await getCollection(subject);
		const groups = new Map<string | null, typeof entries>();
		for (const entry of entries) {
			const g = groupOfId(entry.id);
			if (!groups.has(g)) groups.set(g, []);
			groups.get(g)!.push(entry);
		}

		// flat, subject-wide reading order (same grouping/sorting as the
		// index page) — used to drive the filmstrip picker across every
		// category, not just the current one
		const orderedGroupKeys = sortGroupKeys(subject, [...groups.keys()]);
		const flat: { entry: Entry; group: string | null }[] = [];
		for (const g of orderedGroupKeys) {
			for (const entry of sortEntriesByOrder(groups.get(g)!)) {
				flat.push({ entry, group: g });
			}
		}
		const filmstrip: FilmstripItem[] = flat.map(({ entry, group }) => ({
			id: cleanId(entry.id),
			title: entry.data.title,
			order: entry.data.order ?? null,
			group,
			groupLabel: group ? groupLabel(subject, group) : '',
			hasExercises: entry.data.hasExercises ?? false,
		}));

		for (const group of groups.values()) {
			const sorted = sortEntriesByOrder(group);
			sorted.forEach((entry, i) => {
				paths.push({
					params: { subject, slug: cleanId(entry.id) },
					props: {
						entry,
						subject,
						prev: sorted[i - 1] ?? null,
						next: sorted[i + 1] ?? null,
						filmstrip,
						filmstripIndex: flat.findIndex((f) => f.entry.id === entry.id),
					},
				});
			});
		}
	}
	return paths;
}

const { entry, subject, prev, next, filmstrip, filmstripIndex } = Astro.props as {
	entry: Entry;
	subject: SubjectKey;
	prev: Entry | null;
	next: Entry | null;
	filmstrip: FilmstripItem[];
	filmstripIndex: number;
};
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} activeSubject={subject} wide>
	<p class="eyebrow">
		<a class="back-link" href={`/${subject}/`}>← {SUBJECTS[subject].label}</a>
	</p>
	<h1 data-pagefind-meta="title">{entry.data.title}</h1>
	{
		entry.data.tags?.includes('doplněno') && (
			<p class="doplneno-badge">
				Doplněný obsah — není z archivu podkladů, napsáno podle ŠVP. Vhodné ověřit u vyučujícího.
			</p>
		)
	}
	{
		entry.data.tags?.includes('mimo-seznam-cetby') && (
			<p class="doplneno-badge">
				Toto dílo není na aktuálním školním seznamu četby k maturitě — rozbor je tu jen jako doplněk.
			</p>
		)
	}
	<article class="topic" data-pagefind-body>
		<Content />
	</article>
	{subject === 'mat' && <MathScratchpad />}
	{
		entry.data.source && (
			<p class="source-note">Zdroj: {entry.data.source}</p>
		)
	}
	{
		(prev || next) && (
			<nav class="topic-pager">
				{prev ? (
					<a class="topic-pager-prev" href={`/${subject}/${cleanId(prev.id)}/`}>
						← {prev.data.title}
					</a>
				) : (
					<span />
				)}
				<TopicFilmstrip subject={subject} items={filmstrip} currentIndex={filmstripIndex} />
				{next && (
					<a class="topic-pager-next" href={`/${subject}/${cleanId(next.id)}/`}>
						{next.data.title} →
					</a>
				)}
			</nav>
		)
	}
</BaseLayout>
