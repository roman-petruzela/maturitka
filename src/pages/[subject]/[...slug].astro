---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathScratchpad from '../../components/MathScratchpad.astro';
import SubjectRail from '../../components/SubjectRail.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import { SUBJECTS, SUBJECT_KEYS, type SubjectKey } from '../../lib/subjects';
import { cleanId, groupLabel, groupOfId, sortEntriesByOrder, sortGroupKeys } from '../../lib/groups';
import { getCollection, render } from 'astro:content';

type Entry = Awaited<ReturnType<typeof getCollection<SubjectKey>>>[number];
export type TopicItem = {
	id: string;
	title: string;
	order: number | null;
	group: string | null;
	groupLabel: string;
	hasExercises: boolean;
};

export async function getStaticPaths() {
	const paths: {
		params: { subject: SubjectKey; slug: string };
		props: {
			entry: Entry;
			subject: SubjectKey;
			prev: Entry | null;
			next: Entry | null;
			topics: TopicItem[];
		};
	}[] = [];
	for (const subject of SUBJECT_KEYS) {
		const entries = await getCollection(subject);
		const groups = new Map<string | null, typeof entries>();
		for (const entry of entries) {
			const g = groupOfId(entry.id);
			if (!groups.has(g)) groups.set(g, []);
			groups.get(g)!.push(entry);
		}

		// flat, subject-wide reading order (same grouping/sorting as the
		// index page) — drives the left rail's subject index across every
		// category, not just the current one
		const orderedGroupKeys = sortGroupKeys(subject, [...groups.keys()]);
		const flat: { entry: Entry; group: string | null }[] = [];
		for (const g of orderedGroupKeys) {
			for (const entry of sortEntriesByOrder(groups.get(g)!)) {
				flat.push({ entry, group: g });
			}
		}
		const topics: TopicItem[] = flat.map(({ entry, group }) => ({
			id: cleanId(entry.id),
			title: entry.data.title,
			order: entry.data.order ?? null,
			group,
			groupLabel: group ? groupLabel(subject, group) : '',
			hasExercises: entry.data.hasExercises ?? false,
		}));

		// prev/next walk the flat, subject-wide order rather than staying
		// inside the current category — otherwise the first/last topic of
		// every category (all but one, in a subject with several) silently
		// lost its "Předchozí" or "Další" instead of crossing over into the
		// neighbouring one.
		flat.forEach(({ entry }, i) => {
			paths.push({
				params: { subject, slug: cleanId(entry.id) },
				props: {
					entry,
					subject,
					prev: flat[i - 1]?.entry ?? null,
					next: flat[i + 1]?.entry ?? null,
					topics,
				},
			});
		});
	}
	return paths;
}

const { entry, subject, prev, next, topics } = Astro.props as {
	entry: Entry;
	subject: SubjectKey;
	prev: Entry | null;
	next: Entry | null;
	topics: TopicItem[];
};
const { Content, headings } = await render(entry);

const group = groupOfId(entry.id);
const categoryLabel = group ? groupLabel(subject, group) : undefined;
const currentId = cleanId(entry.id);
const hasFormulas = /\$\$[\s\S]*?\$\$/.test(entry.body ?? '');

// prev/next now walk the whole subject (see getStaticPaths above), so the
// boundary topic of a category points into the neighbouring one — flagged
// here so the UI can say so instead of silently switching context.
function otherGroupLabel(other: Entry | null): string | undefined {
	if (!other) return undefined;
	const otherGroup = groupOfId(other.id);
	if (otherGroup === group) return undefined;
	return otherGroup ? groupLabel(subject, otherGroup) : undefined;
}
const prevOtherGroup = otherGroupLabel(prev);
const nextOtherGroup = otherGroupLabel(next);

// Heading anchors are only useful to the table of contents if they exist;
// a leading heading that just repeats the page title would give the rail a
// redundant first row, so it's dropped.
const normalized = (s: string) => s.trim().toLowerCase().replace(/\s+/g, ' ');
const tocHeadings = headings.filter(
	(h, i) => !(i === 0 && normalized(h.text) === normalized(entry.data.title))
);
---

<BaseLayout
	title={entry.data.title}
	description={`${entry.data.title} — ${SUBJECTS[subject].label}, učební materiál k maturitě.`}
	activeSubject={subject}
	layout="reading"
>
	<div class="reading-shell">
		<SubjectRail
			subject={subject}
			subjectLabel={SUBJECTS[subject].label}
			items={topics}
			currentId={currentId}
		/>

		<div class="reading-column">
			<p class="crumb">
				<a href={`/${subject}/`}>← Zpět na {SUBJECTS[subject].label.toLowerCase()}</a>
			</p>
			<div class="topic-head">
				<h1>{entry.data.title}</h1>
			</div>
			{
				entry.data.tags?.includes('doplněno') && (
					<p class="topic-notice">
						Doplněný obsah — není z archivu podkladů, napsáno podle ŠVP. Vhodné ověřit u vyučujícího.
					</p>
				)
			}
			{
				entry.data.tags?.includes('mimo-seznam-cetby') && (
					<p class="topic-notice">
						Toto dílo není na aktuálním školním seznamu četby k maturitě — rozbor je tu jen jako doplněk.
					</p>
				)
			}
			<article class="topic">
				<Content />
			</article>
			{subject === 'mat' && <MathScratchpad />}
			{entry.data.source && <p class="source-note">Zdroj: {entry.data.source}</p>}
		</div>

		<ArticleAside
			headings={tocHeadings}
			categoryLabel={categoryLabel}
			tags={entry.data.tags ?? []}
			hasExercises={entry.data.hasExercises ?? false}
			prev={
				prev
					? { href: `/${subject}/${cleanId(prev.id)}/`, title: prev.data.title, otherGroupLabel: prevOtherGroup }
					: null
			}
			next={
				next
					? { href: `/${subject}/${cleanId(next.id)}/`, title: next.data.title, otherGroupLabel: nextOtherGroup }
					: null
			}
			hasFormulas={hasFormulas}
		/>
	</div>
</BaseLayout>
