---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';
import { getCollection } from 'astro:content';

const counts: Record<string, number> = {};
for (const key of SUBJECT_KEYS) {
	counts[key] = (await getCollection(key)).length;
}
const total = Object.values(counts).reduce((sum, n) => sum + n, 0);
---

<BaseLayout
	title="Přehled předmětů"
	description={`Přehledně poskládaný učební materiál z archivu maturitních podkladů — ${total} témat napříč ${SUBJECT_KEYS.length} předměty.`}
	layout="index"
>
	<div class="masthead">
		<h1>Archiv maturitních podkladů</h1>
		<p class="masthead-sub">
			Výpisky, přehledy a řešené příklady ze školních materiálů — přepsané do čitelné
			podoby a setříděné podle předmětů.
		</p>
		<p class="masthead-tally">
			<span class="masthead-tally-items">
				<span><b>{total}</b> témat</span>
				<i aria-hidden="true"></i>
				<span><b>{SUBJECT_KEYS.length}</b> předmětů</span>
				<i aria-hidden="true"></i>
				<span>doplňuje se průběžně</span>
			</span>
		</p>
	</div>

	<nav class="subject-index" aria-label="Předměty">
		{
			SUBJECT_KEYS.map((key) => (
				<a class="subject-cell" href={`/${key}/`}>
					<span class="subject-cell-head">
						<span class="subject-cell-title">{SUBJECTS[key].label}</span>
						<span class="subject-cell-leader" aria-hidden="true" />
						<span class="subject-cell-count">{counts[key]}</span>
					</span>
					<span class="subject-cell-desc">{SUBJECTS[key].description}</span>
				</a>
			))
		}
	</nav>
</BaseLayout>
