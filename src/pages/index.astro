---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';
import { getCollection } from 'astro:content';

const counts: Record<string, number> = {};
for (const key of SUBJECT_KEYS) {
	counts[key] = (await getCollection(key)).length;
}
const total = Object.values(counts).reduce((sum, n) => sum + n, 0);
---

<BaseLayout
	title="Přehled předmětů"
	description={`Přehledně poskládaný učební materiál z archivu maturitních podkladů — ${total} témat napříč ${SUBJECT_KEYS.length} předměty.`}
>
	<h1>MATURITKA</h1>
	<p>
		Přehledně poskládaný učební materiál z archivu maturitních podkladů — {total} témat
		napříč {SUBJECT_KEYS.length} předměty, další budou přibývat.
	</p>
	<ol class="record-list">
		{
			SUBJECT_KEYS.map((key, i) => (
				<li>
					<a class="record" href={`/${key}/`}>
						<span class="record-num">{String(i + 1).padStart(2, '0')}</span>
						<div class="record-body">
							<h2 class="record-title">{SUBJECTS[key].label}</h2>
							<span class="record-desc">{SUBJECTS[key].description}</span>
						</div>
						<span class="record-count">{counts[key]} témat</span>
					</a>
				</li>
			))
		}
	</ol>
</BaseLayout>
