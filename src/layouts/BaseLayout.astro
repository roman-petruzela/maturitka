---
import '../styles/global.css';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';
import { version } from '../../package.json';
import Analytics from '@vercel/analytics/astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
	title: string;
	description?: string;
	activeSubject?: string;
	/**
	 * Page shell width. 'prose' is the default single narrow column (404,
	 * licence); 'index' is the wide subject/topic grid; 'reading' is the
	 * three-column article shell, which manages its own inner columns.
	 */
	layout?: 'prose' | 'index' | 'reading';
}

const DEFAULT_DESCRIPTION =
	'Přehledně poskládaný učební materiál k maturitě z archivu maturitních podkladů — matematika, český jazyk, IT, angličtina a další předměty.';

const { title, description = DEFAULT_DESCRIPTION, activeSubject, layout = 'prose' } = Astro.props;
const year = new Date().getFullYear();
const pageTitle = `${title} · MATURITKA`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
		<meta name="theme-color" content="#141311" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MATURITKA" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<script is:inline>
			// Set as early as possible, before the browser gets a chance to do
			// its own (often conflicting) scroll restoration on back/forward —
			// we restore manually further down instead, keyed by pathname so it
			// also works for plain links back to a list page, not just true
			// browser back/forward navigation.
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
		</script>
		<script is:inline>
			// The page crossfade is a cross-document View Transition
			// (@view-transition in global.css), which Firefox-based browsers
			// don't run yet — they have startViewTransition but no
			// `pagereveal`, the event that ships with the cross-document kind.
			// There a softer dim-and-brighten is played on <body> instead (see
			// "vt-fallback" in global.css and the click handler at the end of
			// <body>). Set here, before first paint, so the arriving page
			// doesn't flash in at full brightness first.
			if (!('onpagereveal' in window) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('vt-fallback');
			}
			// A page reached through a view transition already has its entrance —
			// the front page's own rise-in must not play on top of it (global.css).
			window.addEventListener('pagereveal', function (e) {
				if (e.viewTransition) document.documentElement.classList.add('vt-arrived');
			});
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Přeskočit na obsah</a>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href="/" aria-label="MATURITKA – úvodní stránka"><span class="brand-accent">M</span>aturitka<span class="brand-accent">.</span></a>
				<nav class="subject-nav" aria-label="Předměty">
					{
						SUBJECT_KEYS.map((key) => (
							<a
								href={`/${key}/`}
								class={activeSubject === key ? 'active' : ''}
								aria-current={activeSubject === key ? 'page' : undefined}
								draggable="false"
							>
								{SUBJECTS[key].label}
							</a>
						))
					}
				</nav>
				<SearchDialog />
			</div>
		</header>
		<main id="main-content" class={layout}>
			<slot />
		</main>
		<footer class="site-footer">
			<a href="https://github.com/roman-petruzela/maturitka" target="_blank" rel="noopener noreferrer">GitHub</a>
			<span class="site-footer-sep" aria-hidden="true" />
			<a href="/licence/">CC BY-NC-SA 4.0</a>
			<span class="site-footer-sep" aria-hidden="true" />
			<span>© {year} <a href="/o-strance/">MATURITKA</a></span>
			<span class="site-footer-sep" aria-hidden="true" />
			<span>v{version}</span>
		</footer>
		<script is:inline>
			// Restore the saved offsets before the first paint (site-chrome.ts keeps them up to date):
			// the page's own scroll, keyed by pathname so it also works for plain links back to a list
			// page, and the subject strip's sideways scroll, reset on a real reload.
			(function () {
				var saved = sessionStorage.getItem('maturitka-scroll:' + location.pathname);
				// A link to a section (from the search, or a heading's own) must land there. `instant`:
				// html has scroll-behavior: smooth, and a smooth restore visibly scrolled the page on
				// every return — its scroll events also slid the header away.
				if (saved && !location.hash) window.scrollTo({ top: parseInt(saved, 10), behavior: 'instant' });
				var nav = document.querySelector('nav.subject-nav');
				var entry = performance.getEntriesByType('navigation')[0];
				if (entry && entry.type === 'reload') sessionStorage.removeItem('maturitka-nav-scroll');
				else if (nav) nav.scrollLeft = parseInt(sessionStorage.getItem('maturitka-nav-scroll') || '0', 10);
			})();
		</script>
		<script>
			import { initSiteChrome } from '../lib/site-chrome';
			import { initArticlePage } from '../lib/article-page';

			initSiteChrome();
			initArticlePage();
			// The 3D solids of the stereometrie pages can be turned by dragging them; the code is loaded
			// only on a page that has one.
			if (document.querySelector('figure.solid-plot[data-solid]')) {
				import('../lib/solid-viewer').then((m) => m.initSolidViewers());
			}
			// a formula sheet gets a filter box, on the same terms
			if (document.querySelector('.formula-sheet')) {
				import('../lib/formula-filter').then((m) => m.initFormulaFilter());
			}
		</script>
		<Analytics />
	</body>
</html>
