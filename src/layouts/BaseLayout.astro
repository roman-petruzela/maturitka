---
import '../styles/global.css';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';

interface Props {
	title: string;
	activeSubject?: string;
	wide?: boolean;
}

const { title, activeSubject, wide = false } = Astro.props;
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · MATURITKA</title>
		<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
		<script is:inline>
			// Set as early as possible, before the browser gets a chance to do
			// its own (often conflicting) scroll restoration on back/forward —
			// we restore manually further down instead, keyed by pathname so it
			// also works for plain links back to a list page, not just true
			// browser back/forward navigation.
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
		</script>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">MATURIT<span>KA</span></a>
			<nav class="subject-nav">
				{
					SUBJECT_KEYS.map((key) => (
						<a href={`/${key}/`} class={activeSubject === key ? 'active' : ''}>
							{SUBJECTS[key].label}
						</a>
					))
				}
			</nav>
			<div id="search"></div>
		</header>
		<main class={wide ? 'wide' : ''}>
			<slot />
		</main>
		<script>
			// Loaded as a plain <script> tag (not an ES import) on purpose: the
			// /pagefind/ directory only exists after `npm run build`, so in dev
			// mode this 404s and we just skip the search widget silently.
			const pagefindScript = document.createElement('script');
			pagefindScript.src = '/pagefind/pagefind-ui.js';
			pagefindScript.onload = () => {
				// @ts-ignore - global injected by pagefind-ui.js
				if (window.PagefindUI) {
					// @ts-ignore
					new window.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
				}
			};
			pagefindScript.onerror = () => {};
			document.head.appendChild(pagefindScript);
		</script>
		<script is:inline>
			(function () {
				// Scroll position memory: save each page's scroll offset under its
				// own pathname, restore it when that exact page loads again —
				// covers true back/forward navigation and also plain links back to
				// a list page (e.g. the "← Předmět" link on a topic page).
				var scrollKey = 'maturitka-scroll:' + location.pathname;
				var saved = sessionStorage.getItem(scrollKey);
				if (saved) window.scrollTo(0, parseInt(saved, 10));

				var scrollTicking = false;
				function saveScroll() {
					sessionStorage.setItem(scrollKey, String(window.scrollY));
					scrollTicking = false;
				}
				window.addEventListener(
					'scroll',
					function () {
						if (!scrollTicking) {
							requestAnimationFrame(saveScroll);
							scrollTicking = true;
						}
					},
					{ passive: true }
				);

				// Auto-hiding header: slides away on scroll down, reappears on
				// scroll up (past a small threshold so it doesn't jitter right at
				// the top of the page).
				var header = document.querySelector('header.site-header');
				if (!header) return;
				var lastY = window.scrollY;
				var headerTicking = false;
				function updateHeader() {
					var y = window.scrollY;
					if (y > lastY && y > 72) {
						header.classList.add('header-hidden');
					} else if (y < lastY) {
						header.classList.remove('header-hidden');
					}
					lastY = y;
					headerTicking = false;
				}
				window.addEventListener(
					'scroll',
					function () {
						if (!headerTicking) {
							requestAnimationFrame(updateHeader);
							headerTicking = true;
						}
					},
					{ passive: true }
				);
			})();
		</script>
	</body>
</html>
