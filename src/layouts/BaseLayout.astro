---
import '../styles/global.css';
import { SUBJECTS, SUBJECT_KEYS } from '../lib/subjects';
import { version } from '../../package.json';
import Analytics from '@vercel/analytics/astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
	title: string;
	description?: string;
	activeSubject?: string;
	/**
	 * Page shell width. 'prose' is the default single narrow column (404,
	 * licence); 'index' is the wide subject/topic grid; 'reading' is the
	 * three-column article shell, which manages its own inner columns.
	 */
	layout?: 'prose' | 'index' | 'reading';
}

const DEFAULT_DESCRIPTION =
	'Přehledně poskládaný učební materiál k maturitě z archivu maturitních podkladů — matematika, český jazyk, IT, angličtina a další předměty.';

const { title, description = DEFAULT_DESCRIPTION, activeSubject, layout = 'prose' } = Astro.props;
const year = new Date().getFullYear();
const pageTitle = `${title} · MATURITKA`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MATURITKA" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<script is:inline>
			// Set as early as possible, before the browser gets a chance to do
			// its own (often conflicting) scroll restoration on back/forward —
			// we restore manually further down instead, keyed by pathname so it
			// also works for plain links back to a list page, not just true
			// browser back/forward navigation.
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Přeskočit na obsah</a>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href="/">MATURIT<span>KA</span></a>
				<nav class="subject-nav" aria-label="Předměty">
					{
						SUBJECT_KEYS.map((key) => (
							<a
								href={`/${key}/`}
								class={activeSubject === key ? 'active' : ''}
								aria-current={activeSubject === key ? 'page' : undefined}
								draggable="false"
							>
								{SUBJECTS[key].label}
							</a>
						))
					}
				</nav>
				<SearchDialog />
			</div>
		</header>
		<main id="main-content" class={layout}>
			<slot />
		</main>
		<footer class="site-footer">
			<a href="https://github.com/roman-petruzela/maturitka" target="_blank" rel="noopener noreferrer">GitHub</a>
			<span class="site-footer-sep" aria-hidden="true" />
			<a href="/licence/">CC BY-NC-SA 4.0</a>
			<span class="site-footer-sep" aria-hidden="true" />
			<span>© {year} <a href="/o-strance/">MATURITKA</a></span>
			<span class="site-footer-sep" aria-hidden="true" />
			<span>v{version}</span>
		</footer>
		<script is:inline>
			(function () {
				// Scroll position memory: save each page's scroll offset under its
				// own pathname, restore it when that exact page loads again —
				// covers true back/forward navigation and also plain links back to
				// a list page (e.g. the "← Předmět" link on a topic page).
				var scrollKey = 'maturitka-scroll:' + location.pathname;
				var saved = sessionStorage.getItem(scrollKey);
				if (saved) window.scrollTo(0, parseInt(saved, 10));

				var scrollTicking = false;
				function saveScroll() {
					sessionStorage.setItem(scrollKey, String(window.scrollY));
					scrollTicking = false;
				}
				window.addEventListener(
					'scroll',
					function () {
						if (!scrollTicking) {
							requestAnimationFrame(saveScroll);
							scrollTicking = true;
						}
					},
					{ passive: true }
				);

				// Auto-hiding header: slides away on scroll down, reappears on
				// scroll up (past a small threshold so it doesn't jitter right at
				// the top of the page).
				var header = document.querySelector('header.site-header');
				if (!header) return;
				var lastY = window.scrollY;
				var headerTicking = false;
				function updateHeader() {
					var y = window.scrollY;
					if (y > lastY && y > 72) {
						header.classList.add('header-hidden');
						// Mirrored on <body> so the sticky side rails (which
						// aren't descendants of <header>) can close the gap
						// the header leaves behind instead of just sitting
						// under empty space — see .rail-nav/.rail-aside's
						// body.header-hidden override in global.css.
						document.body.classList.add('header-hidden');
					} else if (y < lastY) {
						header.classList.remove('header-hidden');
						document.body.classList.remove('header-hidden');
					}
					lastY = y;
					headerTicking = false;
				}
				window.addEventListener(
					'scroll',
					function () {
						if (!headerTicking) {
							requestAnimationFrame(updateHeader);
							headerTicking = true;
						}
					},
					{ passive: true }
				);

				// Discord-style spoilers: inline "||text||" (rehype-spoiler.ts,
				// class "spoiler") and block-level graphs (graph-svg.ts's
				// "spoiler": true, class "spoiler-block") share the same
				// click/Enter/Space-to-toggle behaviour. Delegated on document so
				// it works for spoilers on every page without a per-page script.
				function toggleSpoiler(el) {
					el.classList.toggle('is-revealed');
				}
				document.addEventListener('click', function (e) {
					var el = e.target.closest && e.target.closest('.spoiler, .spoiler-block');
					if (el) toggleSpoiler(el);
				});
				document.addEventListener('keydown', function (e) {
					if (e.key !== 'Enter' && e.key !== ' ') return;
					var el = e.target.closest && e.target.closest('.spoiler, .spoiler-block');
					if (!el) return;
					e.preventDefault();
					toggleSpoiler(el);
				});

				// Drag-to-scroll for the subject strip, with a fling/momentum
				// finish — touch already gets native momentum scrolling for free
				// from -webkit-overflow-scrolling and is left alone here (early
				// return on pointerType 'touch'), this only fills in the same
				// feel for mouse/pen.
				//
				// Uses Pointer Events rather than separate mousedown/mousemove/
				// mouseup listeners: without disabling it, a pointerdown that
				// starts on an <a> can be hijacked by the browser's native link
				// drag-and-drop gesture, which swallows the following
				// pointermove/pointerup and leaves the drag stuck — hence
				// draggable="false" + the dragstart guard below. Deliberately
				// NOT using setPointerCapture here: capturing the pointer on
				// `nav` retargets the resulting "click" event to `nav` itself
				// instead of the specific <a> underneath, which silently broke
				// navigation entirely (clicking a subject did nothing). Plain
				// window-level move/up listeners avoid that, and are safe now
				// that native link dragging is disabled.
				var nav = document.querySelector('nav.subject-nav');
				if (nav) {
					// Carry the subject strip's horizontal scroll position across
					// page-to-page navigation (clicking a link) so it doesn't jump
					// back to the start on every new page, but reset it to default
					// on an actual reload — sessionStorage alone can't tell those
					// apart (it survives both), so this checks the Navigation
					// Timing entry's type instead.
					var navScrollKey = 'maturitka-nav-scroll';
					var navEntry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
					if (navEntry && navEntry.type === 'reload') {
						sessionStorage.removeItem(navScrollKey);
					} else {
						var savedNavScroll = sessionStorage.getItem(navScrollKey);
						if (savedNavScroll) nav.scrollLeft = parseInt(savedNavScroll, 10);
					}
					var navScrollTicking = false;
					function saveNavScroll() {
						sessionStorage.setItem(navScrollKey, String(nav.scrollLeft));
						navScrollTicking = false;
					}
					nav.addEventListener(
						'scroll',
						function () {
							if (!navScrollTicking) {
								requestAnimationFrame(saveNavScroll);
								navScrollTicking = true;
							}
						},
						{ passive: true }
					);

					var isDown = false;
					var dragged = false;
					var startX = 0;
					var startScroll = 0;
					var lastX = 0;
					var lastT = 0;
					var velocity = 0;
					var momentumId = null;

					function stopMomentum() {
						if (momentumId !== null) {
							cancelAnimationFrame(momentumId);
							momentumId = null;
						}
					}

					function runMomentum() {
						nav.scrollLeft += velocity;
						velocity *= 0.94;
						if (Math.abs(velocity) > 0.4) {
							momentumId = requestAnimationFrame(runMomentum);
						} else {
							momentumId = null;
						}
					}

					nav.addEventListener('dragstart', function (e) {
						e.preventDefault();
					});

					nav.addEventListener('pointerdown', function (e) {
						if (e.pointerType === 'touch') return;
						isDown = true;
						dragged = false;
						stopMomentum();
						nav.classList.add('dragging');
						startX = e.clientX;
						startScroll = nav.scrollLeft;
						lastX = e.clientX;
						lastT = Date.now();
						velocity = 0;
					});

					window.addEventListener('pointermove', function (e) {
						if (!isDown) return;
						var walk = e.clientX - startX;
						if (Math.abs(walk) > 4) dragged = true;
						nav.scrollLeft = startScroll - walk;

						var now = Date.now();
						var dt = now - lastT;
						if (dt > 0) velocity = ((lastX - e.clientX) / dt) * 16;
						lastX = e.clientX;
						lastT = now;
					});

					function endDrag() {
						if (!isDown) return;
						isDown = false;
						nav.classList.remove('dragging');
						if (Math.abs(velocity) > 1) momentumId = requestAnimationFrame(runMomentum);
					}
					window.addEventListener('pointerup', endDrag);
					window.addEventListener('pointercancel', endDrag);

					// A drag that moved the strip shouldn't also fire the link's
					// click and navigate away — only swallow the click when this
					// pointerdown/pointerup pair actually dragged past the threshold.
					nav.addEventListener(
						'click',
						function (e) {
							if (dragged) {
								e.preventDefault();
								e.stopPropagation();
							}
						},
						true
					);
				}
			})();
		</script>
		<script is:inline>
			(function () {
				// ── Postranní panely na úzkých displejích ──────────────────
				// Below the three-column breakpoint each rail collapses behind
				// its own button. Deliberately a button + class rather than
				// <details>: the rails must be plainly visible (and not
				// collapsible) on desktop, and a <details> can't be forced open
				// from CSS across browsers.
				document.querySelectorAll('[data-rail-toggle]').forEach(function (btn) {
					var rail = btn.closest('.rail');
					if (!rail) return;
					btn.addEventListener('click', function () {
						var open = rail.classList.toggle('is-open');
						btn.setAttribute('aria-expanded', String(open));
					});
				});

				// ── Rychlá navigace po kategoriích ────────────────────────
				// CSS handles marking the category block you jumped to (the
				// :target rules), but a pill can't style itself off the URL
				// hash, so the matching one is marked here and kept in sync
				// when the hash changes.
				var jump = document.querySelector('.group-jump');
				if (jump) {
					var pills = Array.prototype.slice.call(jump.querySelectorAll('a[href^="#"]'));
					var syncPills = function () {
						var hash = decodeURIComponent(location.hash.slice(1));
						pills.forEach(function (a) {
							a.classList.toggle('is-active', hash !== '' && decodeURIComponent(a.hash.slice(1)) === hash);
						});
					};
					window.addEventListener('hashchange', syncPills);
					syncPills();
				}

				var article = document.querySelector('article.topic');
				if (!article) return;

				// ── Vzorce, které se vejdou ────────────────────────────────
				// MathLive's sub/superscript, fraction and root boxes each stick a couple
				// of pixels out of their formula (a KaTeX-derived workaround). In a box
				// that scrolls sideways that counted as overflow and put a scrollbar
				// under formulas that plainly fit. Overflow within SLACK is that
				// artefact (pure whitespace) and is let through; anything wider is a
				// real overflow and keeps its scrollbar.
				var SLACK = 10;
				var markFitting = function (root) {
					root.querySelectorAll('.math-inline, .math-display').forEach(function (el) {
						el.classList.toggle('is-fitting', el.scrollWidth - el.clientWidth <= SLACK);
					});
				};
				// A card of a formula sheet (```formulas) that is a little too wide for its column — on a
				// phone, or between the two column layouts — shrinks its formula (down to ~0.78x)
				// rather than scrolling it; only a formula far wider than the card keeps its scrollbar.
				var fitCards = function (root) {
					root.querySelectorAll('.formula-card .math-display').forEach(function (el) {
						el.style.fontSize = '';
						if (el.scrollWidth - el.clientWidth <= SLACK) return;
						var base = parseFloat(getComputedStyle(el).fontSize);
						for (var f = 0.96; f > 0.77; f -= 0.04) {
							el.style.fontSize = (base * f).toFixed(1) + 'px';
							if (el.scrollWidth - el.clientWidth <= SLACK) return;
						}
					});
				};
				fitCards(article);
				markFitting(article);
				var fittingTimer = 0;
				var refit = function () {
					cancelAnimationFrame(fittingTimer);
					fittingTimer = requestAnimationFrame(function () {
						fitCards(article);
						markFitting(article);
					});
				};
				window.addEventListener('resize', refit);
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(refit);

				// ── Vzorce v článku ────────────────────────────────────────
				// The formula digest is cloned out of the article's own
				// rendered display math instead of being derived from the
				// Markdown source a second time — one source of truth, so it
				// can't drift, and it costs nothing at build time.
				var formulaList = document.querySelector('[data-formulas]');
				if (formulaList) {
					var section = formulaList.closest('.rail-section');
					var seen = {};
					var picked = [];
					// A formula inside a spoiler is an answer — it must not leak into the digest.
					// A formula sheet (```formulas) is a digest of its own: listing its couple of
					// hundred cards in the rail again would only repeat the page.
					article.querySelectorAll('.math-display').forEach(function (node, i) {
						if (node.closest('.spoiler, .spoiler-block, .formula-sheet')) return;
						var key = (node.textContent || '').replace(/\s+/g, '');
						if (!key || seen[key]) return;
						seen[key] = true;
						if (!node.id) node.id = 'vzorec-' + (i + 1);
						picked.push(node);
					});

					// What each formula is called, for the small caption above it in the
					// rail (and its tooltip — a caption also works on a phone, where there
					// is no hover). In order of preference: the bold lead-in right before
					// it ("Euklidova věta o výšce:"), else the section heading above it,
					// tidied up: "2) Goniometrické funkce — sin, cos, tg, cotg" ->
					// "Goniometrické funkce".
					var headings = Array.prototype.slice.call(article.querySelectorAll('h2, h3, h4'));
					var cleanLabel = function (s) {
						var t = (s || '')
							.replace(/\s+/g, ' ')
							.replace(/^(?:\d+[a-z]?|[a-z])\s*[.)]\s*/i, '') // "2)", "2b)", "a)"
							.replace(/\s*\([^)]*\)\s*/g, ' ')
							.trim();
						// "Obsah pomocí všech stran — Heronův vzorec": a capitalised tail is the name
						// of the thing and the better label; a lower-case one ("— sin, cos, tg")
						// only elaborates the heading, so there the front part wins.
						var dash = /\s+[\u2014\u2013-]\s+/.exec(t);
						if (dash) {
							var tail = t.slice(dash.index + dash[0].length);
							t = /^\p{Lu}/u.test(tail) ? tail : t.slice(0, dash.index);
						}
						return t.replace(/[:.\s]+$/, '').trim();
					};
					// lead-ins that structure a text rather than name a formula ("Znění: …",
					// "Vzorec: …") — for those the section heading is the better label.
					// ("Příklad" and "Řešení" are kept: they say the formula belongs to a
					// worked example, which is more useful than the section's own title.)
					var GENERIC = /^(znění|vzorce?|pozn|poznámka|pozor|definice|značení|důkaz|tip)(?![\p{L}])/iu;
					// a paragraph that holds nothing but a display formula
					var isFormulaOnly = function (p) {
						return (
							p.tagName === 'P' &&
							p.children.length === 1 &&
							p.firstElementChild.classList.contains('math-display') &&
							(p.textContent || '').trim() === (p.firstElementChild.textContent || '').trim()
						);
					};
					// The bold phrase that opens a paragraph and names what follows —
					// "Euklidova věta o výšce:", "Poloměr kružnice opsané (pomocí …):" — but not
					// a bold word inside a sentence ("Dva vektory jsou **kolmé** právě tehdy,
					// když …"), and not one that itself holds a formula. `stop` is the child of
					// the paragraph where the lead-in text must end (the formula, when it sits
					// in the same paragraph), or null for the whole paragraph.
					var leadIn = function (p, stop) {
						var first = p.firstChild;
						while (first && first.nodeType === 3 && !(first.textContent || '').trim()) first = first.nextSibling;
						if (!first || first.tagName !== 'STRONG' || first.querySelector('.math-inline, .math-display')) return '';
						var bold = (first.textContent || '').trim();
						var label = cleanLabel(bold);
						if (!label || GENERIC.test(label) || !/^\p{Lu}/u.test(label)) return '';
						var text = '';
						for (var c = p.firstChild; c && c !== stop; c = c.nextSibling) text += c.textContent || '';
						text = text.trim();
						// a heading in bold, or a sentence that introduces the formula below it
						return text === bold || /:$/.test(bold) || /:$/.test(text) ? label : '';
					};
					var labelFor = function (node) {
						var para = node.closest('p');
						if (para) {
							// a lead-in opening the same paragraph ...
							var stop = node;
							while (stop.parentNode && stop.parentNode !== para) stop = stop.parentNode;
							var same = leadIn(para, stop);
							if (same) return same;
							// ... or the paragraph just above — looking past other formulas
							// that follow the same lead-in ("a² = c·c_a" then "b² = c·c_b")
							var before = para.previousElementSibling;
							while (before && isFormulaOnly(before)) before = before.previousElementSibling;
							if (before && before.tagName === 'P') {
								var lead = leadIn(before, null);
								if (lead) return lead;
							}
						}
						var heading = null;
						for (var h = 0; h < headings.length; h++) {
							if (headings[h].compareDocumentPosition(node) & Node.DOCUMENT_POSITION_FOLLOWING) heading = headings[h];
							else break;
						}
						return heading ? cleanLabel(heading.textContent) : '';
					};

					var lastLabel = null;
					picked.forEach(function (node) {
						var label = labelFor(node);
						if (label && label !== lastLabel) {
							var head = document.createElement('li');
							head.className = 'rail-formula-heading';
							head.textContent = label;
							formulaList.appendChild(head);
						}
						lastLabel = label;

						var li = document.createElement('li');
						var a = document.createElement('a');
						a.href = '#' + node.id;
						if (label) a.title = label;
						var clone = node.cloneNode(true);

						// Split off an explanatory tail like
						// "\\text{kde } m \\text{ je střední příčka...}" or a
						// standalone aside like "\\text{(poloměr kružnice
						// vepsané)}". MathLive renders \\text{} as .ML__text,
						// so the first one that either opens with a Czech
						// connective or is a fully self-contained "(...)"
						// marks where the formula stops and the prose starts.
						// Everything from there is re-set as plain sentence
						// text below the formula; left in place it rendered
						// as maths and read as a second, broken equation (or,
						// for the parenthetical case, as a fragment of maths
						// notation that wasn't actually notation).
						var NOTE_RE = /^(kde|pro|kdy|přičemž|resp\.)(?![\p{L}])|^\(.+\)[.,;:]?$/iu;
						var texts = clone.querySelectorAll('.ML__text');
						var cut = null;
						for (var t = 0; t < texts.length; t++) {
							if (NOTE_RE.test((texts[t].textContent || '').trim())) {
								cut = texts[t];
								break;
							}
						}
						var noteNodes = [];
						if (cut) {
							// Climb only while the node is the last thing in its
							// parent. Stopping at the first ancestor that still
							// has a following sibling is what keeps the formula:
							// an unconditional climb to the clone's own child
							// grabbed MathLive's single wrapper element, which
							// holds the *whole* expression, so "S = m·v" ended up
							// inside the caption and the formula row went blank.
							var top = cut;
							while (top.parentNode && top.parentNode !== clone && !top.nextSibling) {
								top = top.parentNode;
							}
							var host = top.parentNode;
							var doomed = [];
							for (var n = top; n; n = n.nextSibling) doomed.push(n);
							// The tail is re-set as a sentence: its words become plain text in the
							// caption's own face, everything between them (a fraction, a root, an
							// index) keeps its typeset markup inside a fresh MathLive wrapper.
							// Flattening it with textContent turned "s = (a+b+c)/2" into "s = 2a+b+c".
							var run = null;
							doomed.forEach(function (n) {
								n.parentNode.removeChild(n);
								if (n.nodeType === 1 && n.classList.contains('ML__text')) {
									run = null;
									noteNodes.push(document.createTextNode((n.textContent || '').replace(/\s+/g, ' ')));
								} else if (n.nodeType === 1) {
									if (!run) {
										run = document.createElement('span');
										run.className = 'ML__latex';
										run.appendChild(document.createElement('span')).className = 'ML__base';
										noteNodes.push(run);
									}
									run.firstChild.appendChild(n);
								}
							});
							if (noteNodes.length && noteNodes[0].nodeType === 3) {
								noteNodes[0].textContent = noteNodes[0].textContent.replace(/^[,;\s]+/, '');
							}
							// what joined the tail to the formula ("…, \qquad kde …") goes with it
							while (host.lastChild && !(host.lastChild.textContent || '').replace(/[,;\s​]/g, '')) {
								host.removeChild(host.lastChild);
							}

							// If the split left nothing to show as a formula,
							// it wasn't a formula-plus-prose after all — put it
							// back and show the original.
							if (!(clone.textContent || '').trim()) {
								clone = node.cloneNode(true);
								noteNodes = [];
							}
						}

						a.appendChild(clone);
						if (noteNodes.length) {
							var cap = document.createElement('span');
							cap.className = 'rail-formula-note';
							noteNodes.forEach(function (n) {
								cap.appendChild(n);
							});
							a.appendChild(cap);
						}
						li.appendChild(a);
						formulaList.appendChild(li);
					});
					if (picked.length === 0 && section) section.remove();

					// A formula slightly wider than the rail is shrunk to fit (down to a
					// still-readable size) rather than left to scroll sideways; only one that
					// is far wider keeps its scrollbar. Re-run whenever the rail's width
					// changes — it is 0 while the rail is folded away on a narrow screen.
					var fitFormulas = function () {
						if (!formulaList.clientWidth) return;
						formulaList.querySelectorAll('.math-display').forEach(function (el) {
							el.style.fontSize = '';
							var size = 1.05;
							while (el.scrollWidth > el.clientWidth + SLACK && size > 0.76) {
								size -= 0.04;
								el.style.fontSize = size.toFixed(2) + 'rem';
							}
						});
						markFitting(formulaList);
					};
					if (picked.length > 0) {
						fitFormulas();
						if (window.ResizeObserver) new ResizeObserver(fitFormulas).observe(formulaList);
						if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitFormulas);
					}
				}

				// ── Obsah článku: zvýraznění právě čtené sekce ─────────────
				var toc = document.querySelector('[data-toc]');
				if (toc) {
					var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
					var pairs = [];
					links.forEach(function (a) {
						var target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
						if (target) pairs.push({ link: a, target: target });
					});

					var active = null;
					function syncActive() {
						// last heading whose top has passed under the header —
						// a plain scroll read, which behaves predictably around
						// short sections where IntersectionObserver ratios flap
						var cutoff = 140;
						var current = pairs.length ? pairs[0] : null;
						for (var i = 0; i < pairs.length; i++) {
							if (pairs[i].target.getBoundingClientRect().top <= cutoff) current = pairs[i];
							else break;
						}
						if (!current || current.link === active) return;
						if (active) active.classList.remove('is-active');
						current.link.classList.add('is-active');
						active = current.link;
					}

					var tocTicking = false;
					window.addEventListener(
						'scroll',
						function () {
							if (tocTicking) return;
							tocTicking = true;
							requestAnimationFrame(function () {
								syncActive();
								tocTicking = false;
							});
						},
						{ passive: true }
					);
					syncActive();
				}

				// ── Rejstřík předmětu: nascrollovat na právě otevřené téma ──
				// Scrolls the rail itself, never scrollIntoView(): that is
				// allowed to nudge ancestor scroll containers (including the
				// page) when it judges the target isn't fully in view, which
				// would yank the reader away from the top of the article.
				var rail = document.querySelector('[data-subject-rail]');
				var current = rail && rail.querySelector('.is-current');
				if (rail && current && rail.scrollHeight > rail.clientHeight) {
					var railBox = rail.getBoundingClientRect();
					var itemBox = current.getBoundingClientRect();
					rail.scrollTop += itemBox.top - railBox.top - (rail.clientHeight - itemBox.height) / 2;
				}
			})();
		</script>
		<Analytics />
	</body>
</html>
