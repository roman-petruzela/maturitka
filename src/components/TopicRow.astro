---
import Icon from './Icon.astro';

interface Props {
	href: string;
	title: string;
	order?: number | null;
	hasExercises?: boolean;
	tags?: string[];
}

const { href, title, order = null, hasExercises = false, tags = [] } = Astro.props;
---

<li>
	<a href={href}>
		{/* the gutter is always rendered, even for the handful of archive
		    entries with no `order:` in their frontmatter — dropping it for
		    those pushed their titles out of line with the rest of the column */}
		<span class="num">{order != null ? `${order}.` : ''}</span>
		<span class="topic-title">{title}</span>
		<span class="badge-group">
			{hasExercises && (
				<span class="exercise-badge" title="Obsahuje úlohy na výpočet">
					<Icon name="pencil" size={13} />
				</span>
			)}
			{tags.includes('doplněno') && (
				<span class="mini-badge" title="Doplněný obsah, není z archivu podkladů">
					doplněno
				</span>
			)}
			{tags.includes('mimo-seznam-cetby') && (
				<span class="mini-badge" title="Není na aktuálním školním seznamu četby k maturitě">
					mimo seznam četby
				</span>
			)}
		</span>
	</a>
</li>
