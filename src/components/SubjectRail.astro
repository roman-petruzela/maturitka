---
import type { SubjectKey } from '../lib/subjects';
import type { TopicItem } from '../pages/[subject]/[...slug].astro';

interface Props {
	subject: SubjectKey;
	subjectLabel: string;
	items: TopicItem[];
	currentId: string;
}

const { subject, subjectLabel, items, currentId } = Astro.props;

// The flat, subject-wide reading order is already grouped and sorted by the
// page's getStaticPaths — this only re-segments it into consecutive category
// runs for display, so the rail can never disagree with the order you page
// through.
type Section = { key: string | null; label: string; items: TopicItem[] };
const sections: Section[] = [];
for (const item of items) {
	const last = sections[sections.length - 1];
	if (last && last.key === item.group) last.items.push(item);
	else sections.push({ key: item.group, label: item.groupLabel, items: [item] });
}

// the category you're reading inside, so its heading can be marked too —
// without it the only colour in a 128-row rail is one thin bar you may have
// scrolled past
const currentSection = sections.find((s) => s.items.some((i) => i.id === currentId));
---

<aside class="rail rail-nav" data-subject-rail>
	<button class="rail-toggle" type="button" data-rail-toggle aria-expanded="false">
		<span>Navigace</span>
		<span class="rail-toggle-mark" aria-hidden="true">›</span>
	</button>
	<div class="rail-body">
		<p class="rail-title panel-label">Navigace</p>
		<nav class="rail-tree" aria-label={`Témata předmětu ${subjectLabel}`}>
			{
				sections.map((section) => (
					<div class="rail-tree-group">
						{section.key && (
							<p class={section === currentSection ? 'rail-tree-group-label is-current' : 'rail-tree-group-label'}>
								{section.label}
							</p>
						)}
						<ul class="rail-tree-items">
							{section.items.map((item, i) => (
								<li>
									<a
										href={`/${subject}/${item.id}/`}
										class={item.id === currentId ? 'is-current' : ''}
										aria-current={item.id === currentId ? 'page' : undefined}
									>
										<span class="rail-tree-num">{item.order ?? i + 1}</span>
										<span>{item.title}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>
</aside>
