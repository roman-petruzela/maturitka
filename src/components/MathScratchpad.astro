---
import Icon from './Icon.astro';
// Client-side scratchpad for working through a math problem: a freehand
// whiteboard for the actual work, and a MathLive field for the final
// answer with proper notation (fractions, exponents, roots...). Purely a
// convenience tool — nothing is graded or sent anywhere; content is only
// kept in the browser's localStorage so a half-finished note survives a
// refresh.
const PEN_COLORS = [
	{ value: '#1c1a17', label: 'Černá' },
	{ value: '#c0392b', label: 'Červená' },
	{ value: '#1f6f43', label: 'Zelená' },
	{ value: '#2456a8', label: 'Modrá' },
];
const PEN_WIDTHS = [
	{ value: 2, label: 'Tenké' },
	{ value: 4, label: 'Střední' },
	{ value: 7, label: 'Tlusté' },
];
---

<section class="math-scratchpad" data-scratchpad>
	<div class="scratchpad-head">
		<span class="scratchpad-title"><Icon name="pencil" size={16} /> Pracovní plocha</span>
	</div>

	<div class="whiteboard" data-whiteboard-root>
		<div class="whiteboard-toolbar">
			<div class="whiteboard-group" role="group" aria-label="Barva pera">
				{
					PEN_COLORS.map((c, i) => (
						<button
							type="button"
							class="whiteboard-swatch"
							class:list={[{ 'is-active': i === 0 }]}
							style={`--swatch-color: ${c.value}`}
							data-whiteboard-color={c.value}
							title={c.label}
							aria-label={c.label}
						/>
					))
				}
			</div>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<div class="whiteboard-group" role="group" aria-label="Tloušťka pera">
				{
					PEN_WIDTHS.map((w, i) => (
						<button
							type="button"
							class="whiteboard-width"
							class:list={[{ 'is-active': i === 1 }]}
							data-whiteboard-width={w.value}
							title={w.label}
							aria-label={w.label}
						>
							<span style={`width:${w.value}px; height:${w.value}px`} />
						</button>
					))
				}
			</div>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<div class="whiteboard-exercises" data-whiteboard-exercises>
				<button
					type="button"
					class="whiteboard-exercises-toggle"
					data-whiteboard-exercises-toggle
					title="Přidat zadání na tabuli"
					aria-label="Přidat zadání na tabuli"
					aria-haspopup="true"
					aria-expanded="false"
				>
					<Icon name="clipboard" size={16} />
				</button>
				<div class="whiteboard-exercises-menu" data-whiteboard-exercises-menu hidden>
					<p class="whiteboard-exercises-empty" data-whiteboard-exercises-empty>
						Na téhle stránce se nepodařilo najít žádné zadání.
					</p>
				</div>
			</div>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-eraser"
				data-whiteboard-eraser
				title="Guma"
				aria-label="Guma"
			>
				<Icon name="eraser" size={17} />
			</button>
			<button
				type="button"
				class="whiteboard-clear-toolbar"
				data-whiteboard-clear-toolbar
				title="Vymazat vše"
				aria-label="Vymazat vše"
			>
				<Icon name="trash" size={17} />
			</button>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-fullscreen"
				data-whiteboard-fullscreen
				title="Tabule na celou obrazovku"
				aria-label="Tabule na celou obrazovku"
			>
				<Icon name="expand" size={17} />
			</button>
		</div>
		<div class="whiteboard-canvas-wrap">
			<canvas class="whiteboard-canvas" data-whiteboard-canvas></canvas>
			<p class="whiteboard-hint" data-whiteboard-hint>Piš sem myší, prstem nebo perem…</p>
		</div>
	</div>

	<div class="scratchpad-result-bar">
		<label class="scratchpad-result-label" for="scratchpad-result">Výsledek:</label>
		<math-field
			id="scratchpad-result"
			data-scratchpad-result
			virtual-keyboard-mode="manual"
			math-virtual-keyboard-policy="manual"
			smart-fence
			class="scratchpad-result"
		></math-field>
		<button
			type="button"
			class="scratchpad-keyboard-toggle"
			data-scratchpad-keyboard
			title="Klávesnice se zlomky, mocninami a odmocninami"
			aria-label="Otevřít klávesnici se speciálními znaky"
		>
			<Icon name="keyboard" size={16} />
		</button>
	</div>
</section>

<script>
	import 'mathlive';
	import { Whiteboard, createFloatingNote } from '../lib/whiteboard';
	import { findExercises, buildStatement, buildPreview, type Exercise } from '../lib/exercises';

	function initScratchpads() {
		const sections = document.querySelectorAll<HTMLElement>('[data-scratchpad]');
		sections.forEach((section) => {
			const whiteboardRoot = section.querySelector<HTMLElement>('[data-whiteboard-root]');
			const canvas = section.querySelector<HTMLCanvasElement>('[data-whiteboard-canvas]');
			const canvasWrap = section.querySelector<HTMLElement>('.whiteboard-canvas-wrap');
			const hint = section.querySelector<HTMLElement>('[data-whiteboard-hint]');
			const fullscreenBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-fullscreen]');
			const eraserBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-eraser]');
			const clearToolbarBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-clear-toolbar]');
			const resultField = section.querySelector('[data-scratchpad-result]') as
				| (HTMLElement & { value: string; executeCommand?: (cmd: string) => void })
				| null;
			const keyboardBtn = section.querySelector('[data-scratchpad-keyboard]') as HTMLButtonElement | null;
			if (!whiteboardRoot || !canvas || !canvasWrap || !resultField) return;

			const base = `maturitka-scratchpad:${location.pathname}`;
			const keys = { board: `${base}:board`, result: `${base}:result` };

			const board = new Whiteboard(canvas, () => {
				if (hint) hint.style.display = board.isEmpty() ? '' : 'none';
				const json = board.toJSON();
				if (board.isEmpty()) localStorage.removeItem(keys.board);
				else localStorage.setItem(keys.board, json);
			});

			// size the backing pixel buffer to the element's on-screen size —
			// must happen after layout, and again whenever that size changes
			// (window resize, entering/leaving fullscreen)
			const ro = new ResizeObserver(() => board.resize());
			ro.observe(canvas);
			// a page zoom changes devicePixelRatio, and not always the element's CSS size
			window.addEventListener('resize', () => board.resize());

			const savedBoard = localStorage.getItem(keys.board);
			if (savedBoard) {
				board.loadJSON(savedBoard);
				if (hint) hint.style.display = 'none';
			}

			const savedResult = localStorage.getItem(keys.result);
			if (savedResult) resultField.value = savedResult;

			resultField.addEventListener('input', () => {
				if (resultField.value) localStorage.setItem(keys.result, resultField.value);
				else localStorage.removeItem(keys.result);
			});

			const clearAll = () => {
				board.clear();
				resultField.value = '';
				localStorage.removeItem(keys.result);
			};
			// lives only inside the whiteboard toolbar (not the scratchpad
			// header above it) because the Fullscreen API only renders the
			// fullscreen element — a button living outside whiteboardRoot would
			// become unreachable once the board is fullscreen
			clearToolbarBtn?.addEventListener('click', clearAll);

			// pen color/width toolbar
			const colorButtons = section.querySelectorAll<HTMLButtonElement>('[data-whiteboard-color]');
			colorButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					colorButtons.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');
					board.setColor(btn.dataset.whiteboardColor ?? '#1c1a17');
				});
			});
			const widthButtons = section.querySelectorAll<HTMLButtonElement>('[data-whiteboard-width]');
			widthButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					widthButtons.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');
					board.setWidth(Number(btn.dataset.whiteboardWidth ?? '4'));
				});
			});

			// eraser toggle — picking a color switches back to drawing
			eraserBtn?.addEventListener('click', () => {
				const erasing = eraserBtn.classList.toggle('is-active');
				board.setMode(erasing ? 'erase' : 'draw');
			});
			colorButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					eraserBtn?.classList.remove('is-active');
					board.setMode('draw');
				});
			});

			// fullscreen toggle — CSS :fullscreen makes the whiteboard fill the
			// viewport (see style block below); the ResizeObserver above picks
			// up the resulting size change and redraws automatically
			fullscreenBtn?.addEventListener('click', () => {
				if (document.fullscreenElement) {
					document.exitFullscreen();
				} else {
					whiteboardRoot.requestFullscreen?.();
				}
			});
			document.addEventListener('fullscreenchange', () => {
				fullscreenBtn?.classList.toggle('is-active', document.fullscreenElement === whiteboardRoot);
			});

			// virtual-keyboard-policy is "manual" (no auto-popup on every
			// focus), so give an explicit toggle button for the result field
			keyboardBtn?.addEventListener('click', () => {
				resultField.focus();
				// @ts-ignore - MathLive custom element method
				resultField.executeCommand?.('toggleVirtualKeyboard');
			});

			// Tasks in the article get a "⇥ tabule" button next to them, and are
			// also listed in the "Zadání" dropdown of the whiteboard's own toolbar,
			// which — unlike the article — stays reachable while the whiteboard is
			// in fullscreen (the Fullscreen API only renders the fullscreen element
			// itself, so buttons living outside it become unclickable there).
			// What counts as a task, and what its statement is, lives in
			// ../lib/exercises.ts; the note gets a copy of the statement's markup,
			// so typeset formulas stay formulas.
			const addNote = (exercise: Exercise) => {
				createFloatingNote(canvasWrap, buildStatement(exercise));
				whiteboardRoot.scrollIntoView({ behavior: 'smooth', block: 'center' });
			};

			const exercisesToggle = section.querySelector<HTMLButtonElement>('[data-whiteboard-exercises-toggle]');
			const exercisesMenu = section.querySelector<HTMLElement>('[data-whiteboard-exercises-menu]');
			const exercisesEmpty = section.querySelector<HTMLElement>('[data-whiteboard-exercises-empty]');
			const exercisesRoot = section.querySelector<HTMLElement>('[data-whiteboard-exercises]');

			const article = document.querySelector('article.topic');
			if (article) {
				const exercises = findExercises(article);
				const hostsWithButton = new Set<HTMLElement>();

				exercises.forEach((exercise) => {
					// two tasks can share a host (a heading's statement paragraph that is
					// itself numbered) — one button per place is enough
					if (!hostsWithButton.has(exercise.host)) {
						hostsWithButton.add(exercise.host);
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'exercise-send-btn';
						btn.title = 'Poslat na tabuli';
						btn.setAttribute('aria-label', 'Poslat úlohu na tabuli');
						btn.textContent = '⇥ tabule';
						btn.addEventListener('click', () => addNote(exercise));
						exercise.host.append(document.createTextNode(' '), btn);
					}

					if (exercisesMenu) {
						const item = document.createElement('button');
						item.type = 'button';
						item.className = 'whiteboard-exercises-item';
						item.append(buildPreview(exercise));
						item.addEventListener('click', () => {
							addNote(exercise);
							exercisesMenu.hidden = true;
							exercisesToggle?.setAttribute('aria-expanded', 'false');
						});
						exercisesMenu.appendChild(item);
					}
				});

				if (exercises.length > 0) exercisesEmpty?.remove();
			}

			exercisesToggle?.addEventListener('click', () => {
				if (!exercisesMenu) return;
				exercisesMenu.hidden = !exercisesMenu.hidden;
				exercisesToggle.setAttribute('aria-expanded', String(!exercisesMenu.hidden));
			});
			document.addEventListener('click', (e) => {
				if (!exercisesRoot || !exercisesMenu || exercisesMenu.hidden) return;
				if (!exercisesRoot.contains(e.target as Node)) {
					exercisesMenu.hidden = true;
					exercisesToggle?.setAttribute('aria-expanded', 'false');
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initScratchpads);
	} else {
		initScratchpads();
	}
</script>

<style>
	.math-scratchpad {
		margin-top: 3rem;
		border: 1px solid var(--border);
		border-radius: 0;
		padding: 1.1rem 1.25rem 1.25rem;
		background: var(--surface);
	}

	.scratchpad-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
		font-family: var(--sans);
	}

	.scratchpad-title {
		font-size: var(--t-sm);
		font-weight: 600;
		color: var(--fg);
	}

	.whiteboard {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 2px;
		overflow: hidden;
		background: #fdfdfb;
	}

	.whiteboard:fullscreen {
		border-radius: 0;
		height: 100vh;
	}

	.whiteboard-toolbar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.9rem;
		padding: 0.5rem 0.7rem;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}

	.whiteboard-group {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.whiteboard-swatch {
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		/* a plain transparent border made the black swatch nearly invisible
		   against the (also dark) toolbar background when not selected */
		border: 2px solid var(--border);
		background: var(--swatch-color);
		cursor: pointer;
		padding: 0;
	}

	.whiteboard-swatch.is-active {
		border-color: var(--fg);
		box-shadow: 0 0 0 2px var(--surface);
	}

	.whiteboard-width {
		width: 1.6rem;
		height: 1.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border-radius: 2px;
		border: 1px solid transparent;
		background: none;
		cursor: pointer;
	}

	.whiteboard-width span {
		display: block;
		border-radius: 50%;
		background: var(--muted);
	}

	.whiteboard-width.is-active {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.whiteboard-width.is-active span {
		background: var(--accent);
	}

	.whiteboard-eraser,
	.whiteboard-clear-toolbar,
	.whiteboard-fullscreen {
		width: 2rem;
		height: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		font-size: 1.05rem;
		border-radius: 2px;
		border: 1px solid var(--border);
		background: none;
		color: var(--muted);
		cursor: pointer;
	}

	.whiteboard-exercises {
		position: relative;
		margin-left: auto;
	}

	.whiteboard-exercises-toggle {
		font-family: var(--sans);
		font-size: 0.82rem;
		height: 2rem;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0 0.6rem;
		border-radius: 2px;
		border: 1px solid var(--border);
		background: none;
		color: var(--muted);
		cursor: pointer;
	}

	.whiteboard-exercises-toggle:hover,
	.whiteboard-exercises-toggle[aria-expanded='true'] {
		color: var(--accent);
		border-color: var(--accent);
	}

	.whiteboard-exercises-menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		width: 17rem;
		max-width: 80vw;
		max-height: 18rem;
		overflow-y: auto;
		padding: 0.4rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 2px;
	}

	/* the class selector above has higher specificity than the browser's own
	   default "[hidden] { display: none }" rule, so it was winning and the
	   menu stayed visible regardless of the hidden attribute the toggle
	   button was setting — this rule needs to explicitly win instead */
	.whiteboard-exercises-menu[hidden] {
		display: none;
	}

	.whiteboard-exercises-empty {
		margin: 0;
		padding: 0.4rem;
		font-family: var(--sans);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.whiteboard-eraser:hover,
	.whiteboard-eraser.is-active,
	.whiteboard-clear-toolbar:hover,
	.whiteboard-fullscreen:hover,
	.whiteboard-fullscreen.is-active {
		color: var(--accent);
		border-color: var(--accent);
	}

	.whiteboard-eraser.is-active {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	.whiteboard-canvas-wrap {
		position: relative;
		flex: 1 1 auto;
		/* the same 16:9 as the paper (FRAME_W × FRAME_H in whiteboard.ts), so a board of
		   normal size shows exactly the paper — before, the canvas element's own default
		   size (300×150) accidentally made it 2:1 */
		aspect-ratio: 16 / 9;
		min-height: 16rem;
		overflow: hidden;
		/* ruled paper: the lines are part of the picture, so their spacing follows the
		   board's scale (--wb-s, see whiteboard.ts) — only the line itself stays 1px */
		background-image: repeating-linear-gradient(
			#fdfdfb 0 calc(28px * var(--wb-s, 1) - 1px),
			color-mix(in srgb, var(--muted) 14%, transparent) calc(28px * var(--wb-s, 1) - 1px)
				calc(28px * var(--wb-s, 1))
		);
	}

	.whiteboard:fullscreen .whiteboard-canvas-wrap {
		aspect-ratio: auto;
		min-height: 0;
	}

	/* Fullscreen HUD, Miro-style: the toolbar leaves the top bar and floats
	   as a vertical pill along the left edge instead, over the canvas
	   rather than squeezing it — matches how dedicated whiteboard apps lay
	   out their tools once the canvas itself is the whole viewport. Taken
	   out of normal flow (position: absolute), so .whiteboard-canvas-wrap
	   (flex: 1 1 auto) naturally reclaims the strip of height the toolbar
	   used to occupy at the top. */
	.whiteboard:fullscreen .whiteboard-toolbar {
		position: absolute;
		top: 50%;
		left: 1.25rem;
		transform: translateY(-50%);
		z-index: 20;
		flex-direction: column;
		width: auto;
		padding: 0.6rem 0.5rem;
		border-radius: 2px;
		border: 1.5px solid var(--border);
	}

	.whiteboard:fullscreen .whiteboard-group {
		flex-direction: column;
	}

	/* thin dividers between tool groups, like Miro's floating toolbar — only shown once
	   stacked vertically, a horizontal bar reads fine without them. Real elements in
	   the flex column, so the toolbar's own gap keeps them clear of the buttons: the
	   earlier border-top on the buttons was drawn *as* their top border and ran into
	   its corners. --muted (not --border) on purpose: --border is close enough in tone
	   to the toolbar's background that it nearly vanished. */
	.whiteboard-sep {
		display: none;
	}

	.whiteboard:fullscreen .whiteboard-sep {
		display: block;
		align-self: stretch;
		height: 1px;
		margin: 0.2rem 0.1rem;
		background: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.whiteboard:fullscreen .whiteboard-exercises {
		margin-left: 0;
	}

	.whiteboard:fullscreen .whiteboard-exercises-toggle {
		width: 2rem;
		justify-content: center;
		padding: 0;
	}

	.whiteboard:fullscreen .whiteboard-exercises-menu {
		top: 0;
		left: calc(100% + 0.6rem);
		right: auto;
	}

	/* out of flow: the wrap's size comes from its own aspect ratio, never from the
	   canvas's intrinsic (backing-buffer) size */
	.whiteboard-canvas {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		cursor: none;
	}

	.whiteboard-hint {
		position: absolute;
		top: 0.75rem;
		left: 1rem;
		margin: 0;
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--muted);
		pointer-events: none;
	}

	.scratchpad-result-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1rem;
		padding: 0.7rem 0.8rem;
		border: 1.5px solid var(--accent);
		border-radius: 2px;
		background: color-mix(in srgb, var(--accent) 5%, var(--surface));
	}

	.scratchpad-result-label {
		font-family: var(--sans);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		white-space: nowrap;
	}

	math-field.scratchpad-result {
		flex: 1 1 auto;
		min-width: 0;
		min-height: 2.6rem;
		font-size: 1.1rem;
		padding: 0.3rem 0.6rem;
		background: var(--bg);
		color: var(--fg);
		border: 1px solid var(--border);
		border-radius: 2px;
	}

	/* MathLive auto-adds its own round virtual-keyboard-toggle AND a round
	   context-menu button inside the field — both redundant with (and easy
	   to mistake for) our own .scratchpad-keyboard-toggle button right next
	   to it, so both are hidden here (documented CSS parts, see mathlive's
	   mathfield-element.d.ts) */
	math-field.scratchpad-result::part(virtual-keyboard-toggle),
	math-field.scratchpad-result::part(menu-toggle) {
		display: none;
	}

	.scratchpad-keyboard-toggle {
		flex: 0 0 auto;
		width: 2.6rem;
		height: 2.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		font-size: 1.2rem;
		line-height: 1;
		border-radius: 2px;
		border: 1px solid var(--accent);
		background: var(--accent);
		color: var(--bg);
		cursor: pointer;
		transition: transform 0.12s ease, opacity 0.12s ease;
	}

	.scratchpad-keyboard-toggle:hover {
		opacity: 0.88;
	}

	.scratchpad-keyboard-toggle:active {
		transform: scale(0.94);
	}

	@media (max-width: 480px) {
		.scratchpad-result-bar {
			flex-wrap: wrap;
		}
		math-field.scratchpad-result {
			flex-basis: 100%;
			order: 3;
		}
	}
</style>
