---
import Icon from './Icon.astro';
// Client-side scratchpad for working through a math problem: a freehand
// whiteboard for the actual work, and a MathLive field for the final
// answer with proper notation (fractions, exponents, roots...). Purely a
// convenience tool — nothing is graded or sent anywhere; content is only
// kept in the browser's localStorage so a half-finished note survives a
// refresh.
const PEN_COLORS = [
	{ value: '#1c1a17', label: 'Černá' },
	{ value: '#c0392b', label: 'Červená' },
	{ value: '#1f6f43', label: 'Zelená' },
	{ value: '#2456a8', label: 'Modrá' },
];
const PEN_WIDTHS = [
	{ value: 2, label: 'Tenké' },
	{ value: 4, label: 'Střední' },
	{ value: 7, label: 'Tlusté' },
];
---

<section class="math-scratchpad" data-scratchpad>
	<div class="scratchpad-head">
		<span class="scratchpad-title"><Icon name="pencil" size={16} /> Pracovní plocha</span>
	</div>

	<div class="whiteboard" data-whiteboard-root>
		<div class="whiteboard-toolbar">
			<div class="whiteboard-group" role="group" aria-label="Barva pera">
				{
					PEN_COLORS.map((c, i) => (
						<button
							type="button"
							class="whiteboard-swatch"
							class:list={[{ 'is-active': i === 0 }]}
							style={`--swatch-color: ${c.value}`}
							data-whiteboard-color={c.value}
							title={c.label}
							aria-label={c.label}
						/>
					))
				}
			</div>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<div class="whiteboard-group" role="group" aria-label="Tloušťka pera">
				{
					PEN_WIDTHS.map((w, i) => (
						<button
							type="button"
							class="whiteboard-width"
							class:list={[{ 'is-active': i === 1 }]}
							data-whiteboard-width={w.value}
							title={w.label}
							aria-label={w.label}
						>
							<span style={`width:${w.value}px; height:${w.value}px`} />
						</button>
					))
				}
			</div>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-image"
				data-whiteboard-image
				title="Vložit obrázek (nebo Ctrl+V, nebo přetáhnout soubor na tabuli)"
				aria-label="Vložit obrázek"
			>
				<Icon name="image" size={17} />
			</button>
			<input type="file" accept="image/*" data-whiteboard-image-input hidden />
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-undo"
				data-whiteboard-undo
				title="Zpět (Ctrl+Z)"
				aria-label="Zpět"
				disabled
			>
				<Icon name="undo" size={17} />
			</button>
			<button
				type="button"
				class="whiteboard-redo"
				data-whiteboard-redo
				title="Znovu (Ctrl+Y)"
				aria-label="Znovu"
				disabled
			>
				<Icon name="redo" size={17} />
			</button>
			<button
				type="button"
				class="whiteboard-recenter"
				data-whiteboard-recenter
				title="Celá tabule (zrušit přiblížení)"
				aria-label="Celá tabule"
				disabled
			>
				<Icon name="recenter" size={17} />
			</button>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-eraser"
				data-whiteboard-eraser
				title="Guma"
				aria-label="Guma"
			>
				<Icon name="eraser" size={17} />
			</button>
			<button
				type="button"
				class="whiteboard-clear-toolbar"
				data-whiteboard-clear-toolbar
				title="Vymazat vše"
				aria-label="Vymazat vše"
			>
				<Icon name="trash" size={17} />
			</button>
			<span class="whiteboard-sep" aria-hidden="true"></span>
			<button
				type="button"
				class="whiteboard-paper"
				data-whiteboard-paper
				title="Papír: čtverečky (klikni pro linky)"
				aria-label="Změnit papír"
			>
				<Icon name="paper" size={17} />
			</button>
			<button
				type="button"
				class="whiteboard-fullscreen"
				data-whiteboard-fullscreen
				title="Tabule na celou obrazovku"
				aria-label="Tabule na celou obrazovku"
			>
				<Icon name="expand" size={17} />
			</button>
		</div>
		<div class="whiteboard-canvas-wrap">
			<canvas class="whiteboard-canvas" data-whiteboard-canvas></canvas>
			<p class="whiteboard-hint" data-whiteboard-hint>Piš sem myší, prstem nebo perem… Dva prsty posouvají a přibližují, ťuknutí dvěma prsty vrátí krok. Shift = rovná čára.</p>
		</div>
	</div>

	<div class="scratchpad-result-bar">
		<label class="scratchpad-result-label" for="scratchpad-result">Výsledek:</label>
		<math-field
			id="scratchpad-result"
			data-scratchpad-result
			virtual-keyboard-mode="manual"
			math-virtual-keyboard-policy="manual"
			smart-fence
			class="scratchpad-result"
		></math-field>
		<button
			type="button"
			class="scratchpad-keyboard-toggle"
			data-scratchpad-keyboard
			title="Klávesnice se zlomky, mocninami a odmocninami"
			aria-label="Otevřít klávesnici se speciálními znaky"
		>
			<Icon name="keyboard" size={16} />
		</button>
	</div>
</section>

<script>
	import { Whiteboard, createFloatingNote, notePlacement } from '../lib/whiteboard';

	type MathField = HTMLElement & { value: string; executeCommand?: (cmd: string) => void };

	// MathLive is ~800 kB of script and only the result field needs it, so it is fetched once that
	// field comes near the viewport or the reader reaches for it — not on every math page load.
	// Nothing may touch the field's properties before then: a `value` set on the not yet defined
	// element would shadow MathLive's own accessor once it upgrades.
	let mathlive: Promise<unknown> | null = null;
	const loadMathlive = () => (mathlive ??= import('mathlive'));
	const isMathFieldReady = () => customElements.get('math-field') !== undefined;

	function whenMathFieldNeeded(bar: HTMLElement, ready: () => void): void {
		const load = () => loadMathlive().then(ready);
		const io = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				io.disconnect();
				load();
			},
			{ rootMargin: '600px 0px' }
		);
		io.observe(bar);
		bar.addEventListener('pointerdown', load, { once: true });
		bar.addEventListener('focusin', load, { once: true });
	}

	function initScratchpads() {
		const sections = document.querySelectorAll<HTMLElement>('[data-scratchpad]');
		sections.forEach((section) => {
			const whiteboardRoot = section.querySelector<HTMLElement>('[data-whiteboard-root]');
			const canvas = section.querySelector<HTMLCanvasElement>('[data-whiteboard-canvas]');
			const canvasWrap = section.querySelector<HTMLElement>('.whiteboard-canvas-wrap');
			const hint = section.querySelector<HTMLElement>('[data-whiteboard-hint]');
			const fullscreenBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-fullscreen]');
			const eraserBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-eraser]');
			const clearToolbarBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-clear-toolbar]');
			const resultField = section.querySelector<MathField>('[data-scratchpad-result]');
			const keyboardBtn = section.querySelector('[data-scratchpad-keyboard]') as HTMLButtonElement | null;
			if (!whiteboardRoot || !canvas || !canvasWrap || !resultField) return;

			const base = `maturitka-scratchpad:${location.pathname}`;
			const keys = { board: `${base}:board`, result: `${base}:result`, images: `${base}:images` };

			const undoBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-undo]');
			const redoBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-redo]');
			const recenterBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-recenter]');
			const syncButtons = () => {
				if (undoBtn) undoBtn.disabled = !board.canUndo();
				if (redoBtn) redoBtn.disabled = !board.canRedo();
				if (recenterBtn) recenterBtn.disabled = !board.viewChanged();
			};
			const board = new Whiteboard(
				canvas,
				() => {
					if (hint) hint.style.display = board.isEmpty() ? '' : 'none';
					const json = board.toJSON();
					if (board.isEmpty()) localStorage.removeItem(keys.board);
					else localStorage.setItem(keys.board, json);
					syncButtons();
				},
				syncButtons
			);
			undoBtn?.addEventListener('click', () => board.undo());
			redoBtn?.addEventListener('click', () => board.redo());
			recenterBtn?.addEventListener('click', () => board.resetView());

			// size the backing pixel buffer to the element's on-screen size —
			// must happen after layout, and again whenever that size changes
			// (window resize, entering/leaving fullscreen)
			const ro = new ResizeObserver(() => board.resize());
			ro.observe(canvas);
			// a page zoom changes devicePixelRatio, and not always the element's CSS size
			window.addEventListener('resize', () => board.resize());

			const savedBoard = localStorage.getItem(keys.board);
			if (savedBoard) {
				board.loadJSON(savedBoard);
				if (hint) hint.style.display = 'none';
			}

			whenMathFieldNeeded(resultField.closest<HTMLElement>('.scratchpad-result-bar') ?? resultField, () => {
				const savedResult = localStorage.getItem(keys.result);
				if (savedResult) resultField.value = savedResult;
			});
			resultField.addEventListener('input', () => {
				if (resultField.value) localStorage.setItem(keys.result, resultField.value);
				else localStorage.removeItem(keys.result);
			});

			const clearAll = () => {
				board.clear();
				if (isMathFieldReady()) resultField.value = '';
				localStorage.removeItem(keys.result);
			};
			// lives only inside the whiteboard toolbar (not the scratchpad
			// header above it) because the Fullscreen API only renders the
			// fullscreen element — a button living outside whiteboardRoot would
			// become unreachable once the board is fullscreen
			clearToolbarBtn?.addEventListener('click', clearAll);

			// the paper: squared like a maths exercise book by default, or ruled, or blank —
			// one choice for all pages, it is a matter of taste rather than of the task
			const PAPERS = [
				{ id: 'grid', label: 'čtverečky' },
				{ id: 'lines', label: 'linky' },
				{ id: 'blank', label: 'čistý' },
			];
			const paperKey = 'maturitka-scratchpad:paper';
			const paperBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-paper]');
			const setPaper = (id: string) => {
				const i = Math.max(0, PAPERS.findIndex((p) => p.id === id));
				canvasWrap.dataset.paper = PAPERS[i].id;
				const next = PAPERS[(i + 1) % PAPERS.length];
				if (paperBtn) paperBtn.title = `Papír: ${PAPERS[i].label} (klikni pro ${next.label})`;
			};
			setPaper(localStorage.getItem(paperKey) ?? 'grid');
			paperBtn?.addEventListener('click', () => {
				const i = PAPERS.findIndex((p) => p.id === canvasWrap.dataset.paper);
				const id = PAPERS[(i + 1) % PAPERS.length].id;
				setPaper(id);
				localStorage.setItem(paperKey, id);
			});

			// pen color/width toolbar
			const colorButtons = section.querySelectorAll<HTMLButtonElement>('[data-whiteboard-color]');
			colorButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					colorButtons.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');
					board.setColor(btn.dataset.whiteboardColor ?? '#1c1a17');
				});
			});
			const widthButtons = section.querySelectorAll<HTMLButtonElement>('[data-whiteboard-width]');
			widthButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					widthButtons.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');
					board.setWidth(Number(btn.dataset.whiteboardWidth ?? '4'));
				});
			});

			// eraser toggle — picking a color switches back to drawing
			eraserBtn?.addEventListener('click', () => {
				const erasing = eraserBtn.classList.toggle('is-active');
				board.setMode(erasing ? 'erase' : 'draw');
			});
			colorButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					eraserBtn?.classList.remove('is-active');
					board.setMode('draw');
				});
			});

			// fullscreen toggle — CSS :fullscreen makes the whiteboard fill the
			// viewport (see style block below); the ResizeObserver above picks
			// up the resulting size change and redraws automatically
			fullscreenBtn?.addEventListener('click', () => {
				if (document.fullscreenElement) {
					document.exitFullscreen();
				} else {
					whiteboardRoot.requestFullscreen?.();
				}
			});
			document.addEventListener('fullscreenchange', () => {
				fullscreenBtn?.classList.toggle('is-active', document.fullscreenElement === whiteboardRoot);
			});

			// virtual-keyboard-policy is "manual" (no auto-popup on every
			// focus), so give an explicit toggle button for the result field
			keyboardBtn?.addEventListener('click', () => {
				loadMathlive().then(() => {
					resultField.focus();
					resultField.executeCommand?.('toggleVirtualKeyboard');
				});
			});

			// Pictures on the board — a photo of a worked problem, a graph, a screenshot of a task:
			// the toolbar button, Ctrl+V while the board is in use, or a file dropped on it. A picture
			// is a card on the paper (createFloatingNote), moved by dragging and scaled by its corner,
			// and kept with the drawing. It is shrunk to MAX_IMAGE px first so a few of them still fit
			// into localStorage; if they do not, they stay on the board until the page is left.
			const MAX_IMAGE = 900;
			const imageBtn = section.querySelector<HTMLButtonElement>('[data-whiteboard-image]');
			const imageInput = section.querySelector<HTMLInputElement>('[data-whiteboard-image-input]');
			const images = new Map<HTMLElement, string>();

			const saveImages = () => {
				const list = [...images].map(([note, src]) => ({ src, ...notePlacement(note) }));
				try {
					if (list.length) localStorage.setItem(keys.images, JSON.stringify(list));
					else localStorage.removeItem(keys.images);
				} catch {
					// over the storage quota — the pictures stay on the board for this visit only
				}
			};

			const placeImage = (src: string, placement?: { x: number; y: number; k: number }) => {
				const img = document.createElement('img');
				img.className = 'whiteboard-note-img';
				img.src = src;
				img.alt = 'Obrázek na tabuli';
				img.draggable = false;
				const note = createFloatingNote(canvasWrap, img, {
					...placement,
					onChange: saveImages,
					onClose: () => {
						images.delete(note);
						saveImages();
					},
				});
				note.classList.add('is-image');
				images.set(note, src);
			};

			const shrink = (file: Blob) =>
				new Promise<string>((resolve, reject) => {
					const url = URL.createObjectURL(file);
					const picture = new Image();
					picture.onload = () => {
						const k = Math.min(1, MAX_IMAGE / Math.max(picture.naturalWidth, picture.naturalHeight));
						const c = document.createElement('canvas');
						c.width = Math.max(1, Math.round(picture.naturalWidth * k));
						c.height = Math.max(1, Math.round(picture.naturalHeight * k));
						const cx = c.getContext('2d');
						if (!cx) return reject(new Error('no canvas'));
						cx.fillStyle = '#fff'; // a transparent PNG would turn black as a JPEG
						cx.fillRect(0, 0, c.width, c.height);
						cx.drawImage(picture, 0, 0, c.width, c.height);
						URL.revokeObjectURL(url);
						resolve(c.toDataURL('image/jpeg', 0.82));
					};
					picture.onerror = () => {
						URL.revokeObjectURL(url);
						reject(new Error('not an image'));
					};
					picture.src = url;
				});

			const addImages = async (files: Iterable<Blob>) => {
				for (const file of files) {
					if (!file.type.startsWith('image/')) continue;
					try {
						placeImage(await shrink(file));
					} catch {
						// not a picture the browser can read — ignore it
					}
				}
				saveImages();
			};

			imageBtn?.addEventListener('click', () => imageInput?.click());
			imageInput?.addEventListener('change', () => {
				if (imageInput.files) addImages(imageInput.files);
				imageInput.value = '';
			});

			// Ctrl+V lands on the board only while it is the thing in use: after a press on it, or
			// in fullscreen — a picture pasted into the page anywhere else is none of its business
			let boardInUse = false;
			document.addEventListener('pointerdown', (e) => {
				boardInUse = whiteboardRoot.contains(e.target as Node);
			});
			document.addEventListener('paste', (e) => {
				if (!boardInUse && document.fullscreenElement !== whiteboardRoot) return;
				const files = [...(e.clipboardData?.items ?? [])]
					.filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
					.map((item) => item.getAsFile())
					.filter((f): f is File => f !== null);
				if (!files.length) return;
				e.preventDefault();
				addImages(files);
			});

			canvasWrap.addEventListener('dragover', (e) => {
				if (![...(e.dataTransfer?.types ?? [])].includes('Files')) return;
				e.preventDefault();
				canvasWrap.classList.add('is-drop-target');
			});
			canvasWrap.addEventListener('dragleave', () => canvasWrap.classList.remove('is-drop-target'));
			canvasWrap.addEventListener('drop', (e) => {
				canvasWrap.classList.remove('is-drop-target');
				if (!e.dataTransfer?.files.length) return;
				e.preventDefault();
				addImages(e.dataTransfer.files);
			});

			// the pictures left on the board last time
			try {
				const saved = JSON.parse(localStorage.getItem(keys.images) ?? '[]') as {
					src: string;
					x: number;
					y: number;
					k: number;
				}[];
				for (const n of saved) if (typeof n.src === 'string' && n.src.startsWith('data:image/')) placeImage(n.src, n);
			} catch {
				localStorage.removeItem(keys.images);
			}
			// the task notes of the earlier version of the board are gone
			localStorage.removeItem(`${base}:notes`);

			clearToolbarBtn?.addEventListener('click', () => {
				for (const note of images.keys()) note.remove();
				images.clear();
				saveImages();
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initScratchpads);
	} else {
		initScratchpads();
	}
</script>

<style>
	.math-scratchpad {
		margin-top: 3rem;
		border: 1px solid var(--border);
		border-radius: 0;
		padding: 1.1rem 1.25rem 1.25rem;
		background: var(--surface);
	}

	.scratchpad-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
		font-family: var(--sans);
	}

	.scratchpad-title {
		font-size: var(--t-sm);
		font-weight: 600;
		color: var(--fg);
	}

	.whiteboard {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 2px;
		overflow: hidden;
		background: #fdfdfb;
	}

	.whiteboard:fullscreen {
		border-radius: 0;
		height: 100vh;
	}

	.whiteboard-toolbar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		/* tight enough that the whole toolbar fits on one line of a normal article column */
		gap: 0.45rem 0.5rem;
		padding: 0.45rem 0.6rem;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}

	.whiteboard-group {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.whiteboard-swatch {
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		/* a plain transparent border made the black swatch nearly invisible
		   against the (also dark) toolbar background when not selected */
		border: 2px solid var(--border);
		background: var(--swatch-color);
		cursor: pointer;
		padding: 0;
	}

	.whiteboard-swatch.is-active {
		border-color: var(--fg);
		box-shadow: 0 0 0 2px var(--surface);
	}

	.whiteboard-width {
		width: 1.6rem;
		height: 1.6rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border-radius: 2px;
		border: 1px solid transparent;
		background: none;
		cursor: pointer;
	}

	.whiteboard-width span {
		display: block;
		border-radius: 50%;
		background: var(--muted);
	}

	.whiteboard-width.is-active {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.whiteboard-width.is-active span {
		background: var(--accent);
	}

	.whiteboard-image,
	.whiteboard-undo,
	.whiteboard-redo,
	.whiteboard-recenter,
	.whiteboard-eraser,
	.whiteboard-clear-toolbar,
	.whiteboard-paper,
	.whiteboard-fullscreen {
		width: 1.85rem;
		height: 1.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		font-size: 1.05rem;
		border-radius: 2px;
		border: 1px solid var(--border);
		background: none;
		color: var(--muted);
		cursor: pointer;
	}

	.whiteboard-undo:disabled,
	.whiteboard-redo:disabled,
	.whiteboard-recenter:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.whiteboard-image:hover,
	.whiteboard-undo:not(:disabled):hover,
	.whiteboard-redo:not(:disabled):hover,
	.whiteboard-recenter:not(:disabled):hover,
	.whiteboard-eraser:hover,
	.whiteboard-eraser.is-active,
	.whiteboard-clear-toolbar:hover,
	.whiteboard-paper:hover,
	.whiteboard-fullscreen:hover,
	.whiteboard-fullscreen.is-active {
		color: var(--accent);
		border-color: var(--accent);
	}

	.whiteboard-eraser.is-active {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	.whiteboard-canvas-wrap {
		position: relative;
		flex: 1 1 auto;
		/* the same 16:9 as the paper (FRAME_W × FRAME_H in whiteboard.ts), so a board of
		   normal size shows exactly the paper — before, the canvas element's own default
		   size (300×150) accidentally made it 2:1 */
		aspect-ratio: 16 / 9;
		min-height: 16rem;
		overflow: hidden;
		/* the paper's lines are part of the picture, so their spacing follows the board's
		   scale (--wb-s, see whiteboard.ts) — only the line itself stays 1px. Squared
		   (the default, as in a maths exercise book), ruled or blank: data-paper. */
		--wb-line: color-mix(in srgb, var(--muted) 14%, transparent);
		/* zoom and pan (--wb-z, --wb-px / --wb-py, set by whiteboard.ts) move the paper with the drawing */
