---
// Small monochrome line-icon set (stroke=currentColor, no fill) replacing
// the emoji used around the site — picks up the surrounding text color
// automatically, same weight/style across all of them.
export type IconName = 'pencil' | 'eraser' | 'clipboard' | 'expand' | 'keyboard' | 'trash';

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
	class="icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'pencil' && (
			<>
				<path d="M4 20 L4.9 16.2 L15.3 5.8 A2 2 0 0 1 18.1 5.8 L18.2 5.9 A2 2 0 0 1 18.2 8.7 L7.8 19.1 Z" />
				<path d="M13.6 7.5 L16.5 10.4" />
				<path d="M4 20 L7.8 19.1 L4.9 16.2 Z" />
			</>
		)
	}
	{
		name === 'eraser' && (
			<>
				<path d="M18.5 13 L9.8 21.5 H5.2 L3 19.3 A2 2 0 0 1 3 16.5 L13 6.5 A2 2 0 0 1 15.8 6.5 L18.5 9.2 A2 2 0 0 1 18.5 12 Z" />
				<path d="M12.2 8.3 L16.7 12.8" />
				<path d="M9.8 21.5 H21" />
			</>
		)
	}
	{
		name === 'clipboard' && (
			<>
				<rect x="5" y="4.5" width="14" height="17" rx="1.6" />
				<path d="M9 4.5 A1 1 0 0 1 10 3.5 H14 A1 1 0 0 1 15 4.5 V6 H9 Z" />
				<path d="M8.5 11 H15.5" />
				<path d="M8.5 14.3 H15.5" />
				<path d="M8.5 17.6 H12.5" />
			</>
		)
	}
	{
		name === 'expand' && (
			<>
				<path d="M4 9 V5 A1 1 0 0 1 5 4 H9" />
				<path d="M15 4 H19 A1 1 0 0 1 20 5 V9" />
				<path d="M20 15 V19 A1 1 0 0 1 19 20 H15" />
				<path d="M9 20 H5 A1 1 0 0 1 4 19 V15" />
			</>
		)
	}
	{
		name === 'keyboard' && (
			<>
				<rect x="3" y="6.5" width="18" height="11" rx="1.6" />
				<path d="M6 10 H6.01" />
				<path d="M9 10 H9.01" />
				<path d="M12 10 H12.01" />
				<path d="M15 10 H15.01" />
				<path d="M18 10 H18.01" />
				<path d="M7 14 H17" />
			</>
		)
	}
	{
		name === 'trash' && (
			<>
				<path d="M5 7 H19" />
				<path d="M9 7 V4.5 A1 1 0 0 1 10 3.5 H14 A1 1 0 0 1 15 4.5 V7" />
				<path d="M7 7 L7.8 19.5 A1.5 1.5 0 0 0 9.3 21 H14.7 A1.5 1.5 0 0 0 16.2 19.5 L17 7" />
				<path d="M10.3 10.5 L10.7 17.5" />
				<path d="M13.7 10.5 L13.3 17.5" />
			</>
		)
	}
</svg>
